DISCORD_TOKEN=seu_token_aqui
DISCORD_CLIENT_ID=seu_client_id_aqui
DISCORD_GUILD_ID=seu_guild_id_aqui

# Canal onde os logs de moderação serão enviados
LOG_CHANNEL_ID=id_do_canal_de_log

# API Key da Groq para transcrição de áudio (Whisper)
GROQ_API_KEY=sua_groq_api_key_aqui

# Diretório para salvar gravações temporárias
RECORDINGS_DIR=./recordings

# Tempo máximo de silêncio antes de finalizar gravação (ms)
SILENCE_DURATION=1500

# Ativar/desativar gravação de voz (true/false)
VOICE_RECORDING_ENABLED=true

# Ativar/desativar moderação de texto (true/false)
TEXT_MODERATION_ENABLED=true
